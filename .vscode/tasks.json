{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Go Server",
      "detail": "编译 Go 后端，确保调试使用最新代码",
      "type": "shell",
      "command": "go",
      "args": ["build", "-o", "${workspaceFolder}/cmd/server/__debug_bin.exe", "${workspaceFolder}/cmd/server"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$go"],
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "Start Vite Dev Server",
      "detail": "运行 vite 开发服务器",
      "type": "shell",
      "command": "C:\\Users\\Zz\\.nodejs\\node-v22.12.0-win-x64\\npm.cmd",
      "args": ["run", "dev"],
      "options": {
        "cwd": "${workspaceFolder}/web",
        "shell": {
          "executable": "powershell.exe"
        }
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}
